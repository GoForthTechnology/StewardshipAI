#!/bin/bash

# StewardshipAI Environment Template
# Copy this to setup_env.sh and fill in your values
# Usage: source setup_env.sh

export GCP_PROJECT_ID="your-project-id" # REQUIRED: Use the alphanumeric slug (e.g., stewardship-ai), NOT the project number
export GCP_LOCATION="us-south1"
export GCP_RAG_CORPUS_ID="projects/640385779911/locations/us-south1/ragCorpora/YOUR_CORPUS_ID" # Note: RAG resource paths use the project number

# Firebase Auth Configuration (for Local Testing)
export FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
export FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
export FIREBASE_DATABASE_URL=""
export FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.appspot.com"
export FIREBASE_MESSAGING_SENDER_ID=""
export FIREBASE_APP_ID=""
export FIREBASE_MEASUREMENT_ID=""

# Google OAuth Credentials (for Identity Platform)
export GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
export GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Optional: Set API Key if not using ADC
# export GOOGLE_CLOUD_API_KEY="your-api-key"

echo "StewardshipAI environment variables populated."
